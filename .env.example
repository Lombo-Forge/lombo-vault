# Folders and files to back up, comma separated, absolute paths. App settings, databases, compose files; not the media.
LOMBO_VAULT_SOURCES=/mnt/ssd/appdata,/mnt/ssd/stack/compose.yaml
# Where backups go. Must be outside every source (ideally another disk). Created with mode 0700 if missing.
LOMBO_VAULT_BACKUP_DIR=/mnt/hdd/vault-backups
# age PUBLIC keys (age1...), comma separated. Never put a private key (AGE-SECRET-KEY-...) here.
LOMBO_VAULT_RECIPIENTS=age1changemechangemechangemechangemechangemechangemechangemechangeme
# How many complete backups to keep. At least 1.
LOMBO_VAULT_KEEP=7
# Optional. Comma separated globs for paths to leave out, matched against the full path and each name in it (for example Cache,*.log).
LOMBO_VAULT_EXCLUDE=Cache,*.log
# The age program (a name on PATH or a full path).
LOMBO_VAULT_AGE_BIN=age
# Optional. Path to the age PRIVATE key file. Only `drill` and `doctor` read it; `backup` never does. Empty means the drill is PARTIAL.
LOMBO_VAULT_KEY_FILE=
# The drill fails when the newest backup is older than this many days.
LOMBO_VAULT_MAX_AGE_DAYS=10
# Optional. Folder where the drill unpacks (needs room for the backup's content). Empty uses the system temp folder.
LOMBO_VAULT_SCRATCH_DIR=
# Optional. Any webhook that accepts JSON (Discord, Slack, or a bridge). Empty means no alerts. Failures and every drill result are sent.
LOMBO_VAULT_WEBHOOK_URL=
# Optional. Healthchecks-style URL pinged after each backup (and URL/fail when it fails). Empty means no ping.
LOMBO_VAULT_PING_URL=
# Optional. Same, for the restore drill.
LOMBO_VAULT_DRILL_PING_URL=
# true = old backups are only listed, never deleted (a new backup is still made). Set false after reading the output of `plan`.
LOMBO_VAULT_DRY_RUN=true
# false = refuse to back up onto the same disk as a source (the backup would die with the data). Set true only if you know better.
LOMBO_VAULT_ALLOW_SAME_DISK=false
# Optional. A program (and its arguments, no shell) run before every backup, for example one that makes a consistent copy of a database into a source folder. If it fails, no backup is made. It runs even when DRY_RUN=true, because a backup is always written. See docs/how-it-works.md.
LOMBO_VAULT_PRE_BACKUP_COMMAND=
# Optional. A program run after every backup, also after a failed one, for example to start an app again. If it fails, you are alerted and the exit code is 1.
LOMBO_VAULT_POST_BACKUP_COMMAND=
# Seconds either command may run before it is stopped and counted as failed (1 to 3600).
LOMBO_VAULT_COMMAND_TIMEOUT_SECONDS=60
# Optional. Absolute path of a small JSON file (see docs/contracts.md) rewritten after every backup and drill, for your own monitor. Must be outside every source. Empty means no file.
LOMBO_VAULT_STATUS_FILE=
